<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="480.0" prefWidth="780.0" spacing="20.0"
      style="-fx-background-color: #F0F9FF;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.pae_eventos_javafx_reynoldsydonald.MenuController">

    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <!-- Encabezado Principal -->
    <VBox alignment="CENTER" style="-fx-background-color: #0284C7; -fx-background-radius: 8; -fx-padding: 16;">
        <Label text="Menú Principal de Retos JavaFX" textFill="WHITE">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        <Label text="Seleccione el reto que desea ejecutar" textFill="#E0F2FE">
            <font>
                <Font size="13.0" />
            </font>
        </Label>
    </VBox>

    <!-- Opciones del Menú -->
    <HBox alignment="CENTER" spacing="18.0" VBox.vgrow="ALWAYS">

        <!-- Tarjeta Reto 1 -->
        <VBox alignment="CENTER" prefWidth="220.0" spacing="12.0"
              style="-fx-background-color: #FFFFFF; -fx-border-color: #7DD3FC; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(2, 132, 199, 0.12), 10, 0, 0, 4);">
            <Label text="Reto 1" textFill="#0284C7">
                <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <Label alignment="CENTER" text="Inventario de Pulpería" textFill="#475569" wrapText="true" />
            <Button onAction="#abrirReto1" prefWidth="Infinity"
                    style="-fx-background-color: #0284C7; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6;"
                    text="Abrir Reto 1" />
        </VBox>

        <!-- Tarjeta Reto 2 -->
        <VBox alignment="CENTER" prefWidth="220.0" spacing="12.0"
              style="-fx-background-color: #FFFFFF; -fx-border-color: #7DD3FC; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(2, 132, 199, 0.12), 10, 0, 0, 4);">
            <Label text="Reto 2" textFill="#0284C7">
                <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <Label alignment="CENTER" text="Recepción de Café" textFill="#475569" wrapText="true" />
            <Button onAction="#abrirReto2" prefWidth="Infinity"
                    style="-fx-background-color: #0284C7; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6;"
                    text="Abrir Reto 2" />
        </VBox>

        <!-- Tarjeta Reto 3 -->
        <VBox alignment="CENTER" prefWidth="220.0" spacing="12.0"
              style="-fx-background-color: #FFFFFF; -fx-border-color: #7DD3FC; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(2, 132, 199, 0.12), 10, 0, 0, 4);">
            <Label text="Reto 3" textFill="#0284C7">
                <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <Label alignment="CENTER" text="Tienda de Artesanías" textFill="#475569" wrapText="true" />
            <Button onAction="#abrirReto3" prefWidth="Infinity"
                    style="-fx-background-color: #0284C7; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6;"
                    text="Abrir Reto 3" />
        </VBox>

    </HBox>
</VBox>