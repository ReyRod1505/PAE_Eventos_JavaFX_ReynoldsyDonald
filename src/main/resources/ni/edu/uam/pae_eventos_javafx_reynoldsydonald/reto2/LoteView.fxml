<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="850.0" spacing="18.0"
      style="-fx-background-color: #F0F9FF;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.pae_eventos_javafx_reynoldsydonald.reto2.controlador.LoteController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Header superior -->
    <VBox style="-fx-background-color: #0284C7; -fx-background-radius: 8; -fx-padding: 14 18;">
        <Label text="Recepción de Lotes de Café" textFill="WHITE">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        <Label text="Registre un lote | Clic izquierdo para ver detalles | Clic derecho para opciones" textFill="#E0F2FE">
            <font>
                <Font size="12.0" />
            </font>
        </Label>
    </VBox>

    <!-- Contenedor principal con 3 columnas -->
    <HBox spacing="18.0" VBox.vgrow="ALWAYS">

        <!-- Formulario de Registro -->
        <VBox prefWidth="230.0" spacing="12.0"
              style="-fx-background-color: #FFFFFF; -fx-border-color: #7DD3FC; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 15;">

            <Label text="Nuevo Lote" textFill="#0369A1">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Label>

            <VBox spacing="4.0">
                <Label text="Productor:" textFill="#334155"><font><Font size="12.0" /></font></Label>
                <TextField fx:id="txtProductor" promptText="Nombre del productor" />
            </VBox>

            <VBox spacing="4.0">
                <Label text="Quintales:" textFill="#334155"><font><Font size="12.0" /></font></Label>
                <TextField fx:id="txtQuintales" promptText="Ej: 45.5" />
            </VBox>

            <VBox spacing="4.0">
                <Label text="Variedad:" textFill="#334155"><font><Font size="12.0" /></font></Label>
                <TextField fx:id="txtVariedad" promptText="Ej: Bourbon / Caturra" />
            </VBox>

            <Button onAction="#registrarLote" prefWidth="Infinity"
                    style="-fx-background-color: #0284C7; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6;"
                    text="Guardar Lote">
                <padding>
                    <Insets bottom="8.0" top="8.0" />
                </padding>
            </Button>
        </VBox>

        <!-- Tabla de lotes -->
        <TableView fx:id="tblLotes" HBox.hgrow="ALWAYS"
                   style="-fx-background-radius: 8; -fx-border-color: #BAE6FD; -fx-border-radius: 8; -fx-border-width: 1;">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colProductor" prefWidth="160.0" text="Productor" />
                <TableColumn fx:id="colQuintales" prefWidth="80.0" text="Quintales" />
                <TableColumn fx:id="colVariedad" prefWidth="100.0" text="Variedad" />
            </columns>
        </TableView>

        <!-- Tarjeta de Detalles -->
        <VBox prefWidth="210.0" spacing="12.0"
              style="-fx-background-color: #FFFFFF; -fx-border-color: #7DD3FC; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(2, 132, 199, 0.12), 10, 0, 0, 4);">

            <Label text="Detalles del Lote" textFill="#0369A1">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Label>

            <VBox spacing="10.0">
                <Label fx:id="lblDetalleId" text="ID: -" textFill="#0F172A" />
                <Label fx:id="lblDetalleProductor" text="Productor: -" textFill="#0F172A" />
                <Label fx:id="lblDetalleQuintales" text="Quintales: -" textFill="#0F172A" />
                <Label fx:id="lblDetalleVariedad" text="Variedad: -" textFill="#0F172A" />
            </VBox>
        </VBox>

    </HBox>
</VBox>